# Os valores em "data" PRECISAM estar em base64.
# Gere assim:  echo -n 'VALOR' | base64
#
# AWS ACADEMY: as credenciais (Learner Lab > AWS Details > AWS CLI) EXPIRAM
# a cada sessão (~4h). Quando renovar o lab, refaça este Secret e rode:
#   kubectl -n microservices rollout restart deployment/analytics-service
#
# CONTA PESSOAL: prefira IRSA e nem crie este Secret
# (o Deployment trata o Secret como opcional).
apiVersion: v1
kind: Secret
metadata:
  name: analytics-service-secret
  namespace: microservices
type: Opaque
data:
  AWS_ACCESS_KEY_ID: Q0hBTkdFLU1F          # "CHANGE-ME" -> troque
  AWS_SECRET_ACCESS_KEY: Q0hBTkdFLU1F      # "CHANGE-ME" -> troque
  AWS_SESSION_TOKEN: Q0hBTkdFLU1F          # "CHANGE-ME" -> troque (só Academy)
